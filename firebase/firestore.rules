rules_version = '2';

// car-town-remake — oyuncu kayıtları + arkadaşlık.
// Her oyuncu YALNIZCA kendi players/{uid} dokümanını okuyup yazabilir.
// Anonim hesaplar da giriş yapmış sayılır ama oyun buluta yalnızca Google hesabıyla yazar.
//
// ARKADAŞLIK belgelerinin kimliği hiçbir zaman çıplak UID değildir (g_ / r_ / o_ / f_ öneki):
// Firebase eklentisi sonuçları yalnızca belge kimliğiyle bildirir, koleksiyonu söylemez. Bulut kaydı
// (players/{uid}) kendi sonucunu kimlik == UID diye tanır; önek iki sistemin yanıtlarını ayırır.
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidPlayer(request.resource.data);
    }

    // HERKESE AÇIK GARAJ: yalnızca görsel veri (para / gem / kasa yok). Giriş yapmış herkes okur
    // (arkadaş kodu ile bulunur, ziyaret edilir), yalnızca sahibi yazar.
    match /garages/{garageId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && garageId == 'g_' + request.auth.uid
        && isValidGarage(request.resource.data);
      allow delete: if signedIn() && garageId == 'g_' + request.auth.uid;
    }

    // PROFİL FOTOĞRAFI: avatars/a_{uid} = {img: 192 px JPEG (base64), hash, at}. Kullanıcı kararı (2026-10-16):
    // giriş yapmış HERKES görebilir; yalnızca sahibi yazar / siler. Açık garajdaki "av" = "img:<hash>" bu belgeyi
    // gösterir, arkadaş hash değişmedikçe yeniden indirmez.
    match /avatars/{avatarId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && avatarId == 'a_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['img', 'hash', 'at'])
        && request.resource.data.img is string && request.resource.data.img.size() > 0
        && request.resource.data.img.size() <= 40000
        && request.resource.data.hash is string && request.resource.data.hash.matches('^[0-9a-f]{8}$')
        && request.resource.data.at is int;
      allow delete: if signedIn() && avatarId == 'a_' + request.auth.uid;
    }

    // ŞİKÂYET (Play kullanıcı içeriği politikası): reports/x_{şikâyetçi}_{hedef}. Yalnızca YAZILIR; okuma ve silme
    // istemciye kapalı (Firebase konsolundan incelenir). Bir oyuncu aynı kişiyi bir belgeyle şikâyet eder (yeniden
    // şikâyet aynı belgenin üzerine yazar: spam yok). "img": şikâyet anında görülen fotoğraf (sonra değişse de kalsın).
    match /reports/{reportId} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['target', 'reason', 'av', 'img', 'name', 'at'])
        && request.resource.data.target is string && request.resource.data.target != request.auth.uid
        && reportId == 'x_' + request.auth.uid + '_' + request.resource.data.target
        && request.resource.data.reason in ['photo', 'name', 'garage']
        && request.resource.data.av is string && isValidAv(request.resource.data.av)
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && (!('img' in request.resource.data) || (request.resource.data.img is string
          && request.resource.data.img.size() <= 40000))
        && request.resource.data.at is int;
      allow read, delete: if false;
    }

    // TELEFON BİLDİRİMİ JETONU: push/p_{uid} = {token, lang, at}. Oyuncu ARKADAŞLAR → YARIŞ BİLDİRİMLERİ: AÇ ile yazar;
    // Cloud Function (functions/news.js, yönetici yetkisi) okur. Yalnızca sahibi yazar / okur / siler.
    // push_log/l_{alıcı}_{gönderen} (6 saatlik bildirim sınırı) YALNIZCA sunucunundur: istemciye kapalı (aşağıdaki
    // "başka her yol kapalı" kuralı; yönetici SDK'sı kurallardan bağımsızdır).
    match /push/{pushId} {
      allow read, delete: if signedIn() && pushId == 'p_' + request.auth.uid;
      allow create, update: if signedIn() && pushId == 'p_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['token', 'lang', 'at'])
        && request.resource.data.token is string && request.resource.data.token.size() > 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.lang in ['tr', 'en', 'es', 'de', 'fr']
        && request.resource.data.at is int;
    }

    // ARKADAŞ KODU → UID. Kod bir kez alınır (üzerine yazılamaz), yalnızca sahibi siler.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ARKADAŞ DAVETİ (link, 2026-10-17): invites/{jeton} = {uid, name, code, at}. Sahibi yazar; `at` sunucu saatine
    // ±10 dk (davetin ömrü buna göre hesaplanır, istemci saatiyle uzatılamaz). Giriş yapmış herkes JETONLA tek belge
    // okur (jeton sırdır; liste kapalı), sahibi siler. Davet INVITE_TTL (1 saat) geçerli: linki açan oyuncu bu sürede
    // iki arkadaşlık belgesini de yazabilir (gönderen onaylamaz — linki kendisi gönderdi). Bkz. friends.
    match /invites/{token} {
      allow get: if signedIn();
      allow create: if signedIn() && token.matches('^[A-HJ-NP-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'code', 'at'])
        && request.resource.data.uid == request.auth.uid
        && isValidName(request.resource.data.name)
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.at is int
        && request.resource.data.at * 1000 > request.time.toMillis() - 600000
        && request.resource.data.at * 1000 < request.time.toMillis() + 600000;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      // GELEN İSTEK: users/{alıcı}/inbox/r_{gönderen}. Gönderen yazar; alıcı ve gönderen okur / siler.
      match /inbox/{reqId} {
        allow read, delete: if signedIn()
          && (request.auth.uid == uid || reqId == 'r_' + request.auth.uid);
        allow create, update: if signedIn() && reqId == 'r_' + request.auth.uid
          && uid != request.auth.uid && isValidRequest(request.resource.data);
      }

      // GİDEN İSTEK (gönderenin bekleyen listesi): users/{gönderen}/outbox/o_{alıcı}.
      // Sahibi yazar / okur; alıcı kabul ya da ret edince siler.
      match /outbox/{outId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && outId.matches('^o_.+')
          && outId != 'o_' + uid && isValidRequest(request.resource.data);
        allow delete: if isOwner(uid) || (signedIn() && outId == 'o_' + request.auth.uid);
      }

      // HURDALIK HEDİYESİ: users/{alıcı}/gifts/p_{gönderen}_{gün}. Alıcı açık garajında bir parça İSTER
      // (garages/g_{alıcı}.ask.part); ARKADAŞI o parçadan 1 tane gönderir. Gün = sunucu saatiyle UTC gün
      // numarası, hem kimlikte hem belgede: bir arkadaş aynı kişiye günde EN ÇOK BİR hediye gönderebilir.
      // Alıcı bugünün hediyesini SİLEMEZ (silseydi gönderen aynı gün yeniden yazabilirdi): toplananları
      // kendi kaydında hatırlar, yalnızca dünkü ve daha eski belgeleri temizler. Yalnızca İSTENEN parça.
      // HESAP SİLME: açık garaj önce silinir; garajı olmayan oyuncu bugünün hediyesini de silebilir
      // (garaj yoksa istek de yoktur, kimse yeni hediye gönderemez: günlük sınır açılmaz).
      match /gifts/{giftId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) && (resource.data.day < today()
          || !exists(/databases/$(database)/documents/garages/$('g_' + uid)));
        allow create: if signedIn() && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['part', 'name', 'at', 'day'])
          && request.resource.data.day == today()
          && giftId == 'p_' + request.auth.uid + '_' + string(today())
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$('f_' + request.auth.uid))
          && request.resource.data.part == get(/databases/$(database)/documents/garages/$('g_' + uid)).data.ask.part
          && isValidName(request.resource.data.name)
          && request.resource.data.at is int;
      }

      // YARIŞ HABERİ: users/{alıcı}/races/e_{gönderen}. Gönderen alıcının aracına karşı yarıştı (kazandı ya da kaybetti);
      // alıcı haberi görür, gönderen kazandıysa İNTİKAM AL ile gönderenin o aracına (boya + modifiye) karşı yarışır.
      // Gönderen başına TEK belge (en son yarış üzerine yazılır: spam yok). Yalnızca ARKADAŞ yazabilir. mw / ml:
      // gönderenin kendi yönündeki toplam galibiyet / mağlubiyeti (skor tabelası; o yönü yalnızca gönderen sayar).
      // Alıcı okur / siler; gönderen kendi haberini silebilir (hesap silme).
      match /races/{eventId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) || (signedIn() && eventId == 'e_' + request.auth.uid);
        allow create, update: if signedIn() && uid != request.auth.uid && eventId == 'e_' + request.auth.uid
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$('f_' + request.auth.uid))
          && isValidRaceEvent(request.resource.data);
      }

      // ZİYARET + BEĞENİ (OTO MANŞET, 2026-10-17): users/{sahip}/visits/v_{ziyaretçi} = {name, at, day, liked}. Arkadaşının
      // garajını gezen, kendi garajına dönünce yazar; yalnızca ARKADAŞ, kendi adına, ziyaretçi başına TEK belge (son ziyaret
      // üzerine yazılır: spam yok). liked: kalbe bastı — sahip ziyaretçi başına günde en çok bir beğeni sayar (day = sunucunun
      // UTC günü). Sahip okur ve okuyunca siler; ziyaretçi kendi belgesini silebilir (hesap silme), başkalarınınkini okuyamaz.
      match /visits/{visitId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) || (signedIn() && visitId == 'v_' + request.auth.uid);
        allow create, update: if signedIn() && uid != request.auth.uid && visitId == 'v_' + request.auth.uid
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$('f_' + request.auth.uid))
          && request.resource.data.keys().hasOnly(['name', 'at', 'day', 'liked'])
          && isValidName(request.resource.data.name)
          && request.resource.data.at is int
          && request.resource.data.day == today()
          && request.resource.data.liked is bool;
      }

      // ARKADAŞLAR: users/{sahip}/friends/f_{diğer}. İlişki karşılıklıdır ve YALNIZCA ALICI kabul
      // ederken kurulur: iki belgeyi de alıcı yazar, o anda kendi gelen kutusunda istek durmalıdır.
      //   alıcı kendi listesine:      sahip == alıcı,  inbox/alıcı/r_{diğer} var
      //   alıcı gönderenin listesine:  diğer == alıcı,  inbox/alıcı/r_{sahip} var
      // DAVET LİNKİ: istek yerine geçerli davet (belgedeki `inv` jetonu; daveti diğer taraf oluşturmuş olmalı):
      //   linki açan kendi listesine:  sahip == açan,  invites/inv.uid == diğer
      //   açan davet edenin listesine:  diğer == açan,  invites/inv.uid == sahip
      // Kendini arkadaş ekleme yok. Silme (arkadaşlıktan çıkarma): iki taraf da iki belgeyi silebilir.
      match /friends/{friendId} {
        allow read: if isOwner(uid);
        allow create, update: if signedIn() && friendId.matches('^f_.+') && friendId != 'f_' + uid
          && request.resource.data.keys().hasOnly(['since', 'inv'])
          && request.resource.data.since is int
          && (
            (request.auth.uid == uid
              && exists(/databases/$(database)/documents/users/$(uid)/inbox/$('r_' + friendId[2:])))
            || (friendId == 'f_' + request.auth.uid
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/inbox/$('r_' + uid)))
            || (request.auth.uid == uid && isValidInvite(request.resource.data, friendId[2:]))
            || (friendId == 'f_' + request.auth.uid && isValidInvite(request.resource.data, uid))
          );
        allow delete: if signedIn()
          && (request.auth.uid == uid || friendId == 'f_' + request.auth.uid);
      }
    }

    // Başka her yol kapalı.
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    // UTC gün numarası (sunucu saati): hediyenin günlük sınırı.
    function today() {
      return int(request.time.toMillis() / 86400000);
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Yalnızca oyunun yazdığı alanlar; token / şifre gibi ek alanlar reddedilir.
    function isValidPlayer(data) {
      return data.keys().hasOnly(['profile', 'save_version', 'save_json', 'updated_at'])
        && data.save_version is int
        && data.save_json is string
        && data.save_json.size() < 20000
        && data.updated_at is int
        && (!('profile' in data) || isValidProfile(data.profile));
    }

    function isValidProfile(p) {
      return p is map
        && p.keys().hasOnly(['display_name', 'email', 'photo_url'])
        && (!('display_name' in p) || p.display_name is string)
        && (!('email' in p) || p.email is string)
        && (!('photo_url' in p) || p.photo_url is string);
    }

    // Takma ad: 3–16 karakter, harf / rakam / boşluk / . _ - (Türkçe harfler dahil).
    function isValidName(n) {
      return n is string && n.matches('^[A-Za-z0-9ÇĞİÖŞÜçğıöşü ._-]{3,16}$');
    }

    // Hurdalık parçaları (vehicles/restorations.json "parts"): arkadaştan istenebilenler.
    function isPart(p) {
      return p in ['bolt', 'nut', 'paint', 'spark_plug', 'piston', 'gear', 'motor_oil', 'belt', 'fiberglass'];
    }

    function isValidAsk(a) {
      return a is map && a.keys().hasOnly(['part', 'at']) && isPart(a.part) && a.at is int;
    }

    // PROFİL alanları (PlayerProfile.public_fields): avatar tanımı, çerçeve, bayrak, garaj adı, vitrin aracı, sayılar.
    function isValidAv(a) {
      return a is string && a.matches('^(p[0-9]{2}|img:[0-9a-f]{8})?$');
    }

    // likes: garajın toplam beğenisi (OTO MANŞET; sahibi sayar, isteğe bağlı — eski istemci yazmaz).
    function isValidStats(s) {
      return s is map && s.keys().hasOnly(['wins', 'races', 'cars', 'best', 'best_car', 'likes'])
        && s.wins is int && s.races is int && s.cars is int && s.best is int
        && s.best_car is string && s.best_car.matches('^[a-z0-9_]{0,40}$')
        && (!('likes' in s) || (s.likes is int && s.likes >= 0));
    }

    function isValidGarage(data) {
      return data.keys().hasOnly(['name', 'code', 'level', 'value', 'garage_json', 'updated_at', 'ask',
          'av', 'frame', 'flag', 'title', 'car', 'stats'])
        && (!('ask' in data) || isValidAsk(data.ask))
        && (!('av' in data) || isValidAv(data.av))
        && (!('frame' in data) || (data.frame is string && data.frame.matches('^[a-z_]{1,16}$')))
        && (!('flag' in data) || (data.flag is string && data.flag.matches('^([A-Z]{2})?$')))
        && (!('title' in data) || (data.title is string && data.title.matches('^[A-Za-z0-9ÇĞİÖŞÜçğıöşü ._-]{0,20}$')))
        && (!('car' in data) || (data.car is string && data.car.matches('^[a-z0-9_]{0,40}$')))
        && (!('stats' in data) || isValidStats(data.stats))
        && isValidName(data.name)
        && data.code is string && data.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && data.level is int
        && data.value is int
        && data.garage_json is string
        && data.garage_json.size() < 20000
        && data.updated_at is int;
    }

    function isStage(build, key) {
      return !(key in build) || (build[key] is int && build[key] >= 0 && build[key] <= 5);
    }

    function isValidRaceEvent(d) {
      return d.keys().hasOnly(['name', 'car', 'paint', 'build', 'their_car', 'won', 'revenge', 'mw', 'ml', 'at'])
        && isValidName(d.name)
        && d.car is string && d.car.matches('^[a-z0-9_]{1,40}$')
        && d.their_car is string && d.their_car.matches('^[a-z0-9_]{1,40}$')
        && d.paint is string && d.paint.matches('^([0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$')
        && d.build is map && d.build.keys().hasOnly(['motor', 'turbo', 'air', 'gear', 'tire', 'body'])
        && isStage(d.build, 'motor') && isStage(d.build, 'turbo') && isStage(d.build, 'air')
        && isStage(d.build, 'gear') && isStage(d.build, 'tire') && isStage(d.build, 'body')
        && d.won is bool && d.revenge is bool
        && d.mw is int && d.mw >= 0 && d.ml is int && d.ml >= 0
        && d.at is int;
    }

    // Arkadaşlık belgesindeki davet jetonu geçerli mi: davet var, `inviter` oluşturmuş, 1 saati dolmamış.
    function isValidInvite(data, inviter) {
      return data.inv is string && data.inv.matches('^[A-HJ-NP-Z2-9]{12}$')
        && exists(/databases/$(database)/documents/invites/$(data.inv))
        && get(/databases/$(database)/documents/invites/$(data.inv)).data.uid == inviter
        && (get(/databases/$(database)/documents/invites/$(data.inv)).data.at + 3600) * 1000 > request.time.toMillis();
    }

    function isValidRequest(data) {
      return data.keys().hasOnly(['name', 'code', 'at'])
        && isValidName(data.name)
        && data.code is string && data.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && data.at is int;
    }
  }
}
